# Copia questo file in .env e cambia i valori prima del deploy.

# Password di accesso alla piattaforma (una sola, condivisa dal team).
APP_PASSWORD=cambiami-subito

# Chiave per firmare i cookie di sessione. Generala con:
#   openssl rand -hex 32
SESSION_SECRET=cambiami-con-una-stringa-casuale-lunga

# Porta libera sulla VPS su cui esporre l'app.
PORTA_HOST=8099

TZ=Europe/Rome
